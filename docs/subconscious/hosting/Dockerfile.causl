# Build from the inspected native image. Do not substitute an unverified upstream tag.
ARG BURN_BASE_IMAGE
FROM ${BURN_BASE_IMAGE}
ARG CAUSL_SOURCE_REVISION
LABEL io.subconscious.causl.source=${CAUSL_SOURCE_REVISION}

COPY backend/onyx/auth/users.py /app/onyx/auth/users.py
COPY backend/onyx/auth/session_identity.py /app/onyx/auth/session_identity.py
COPY backend/onyx/chat/chat_state.py /app/onyx/chat/chat_state.py
COPY backend/onyx/chat/process_message.py /app/onyx/chat/process_message.py
COPY backend/onyx/chat/llm_loop.py /app/onyx/chat/llm_loop.py
COPY backend/onyx/prompts/causl_workspace.py /app/onyx/prompts/causl_workspace.py
COPY backend/onyx/db/chat.py /app/onyx/db/chat.py
COPY backend/onyx/db/causl_statement.py /app/onyx/db/causl_statement.py
COPY backend/onyx/db/causl_workspace.py /app/onyx/db/causl_workspace.py
COPY backend/onyx/db/session_identity.py /app/onyx/db/session_identity.py
COPY backend/onyx/server/query_and_chat/chat_backend.py /app/onyx/server/query_and_chat/chat_backend.py
COPY backend/onyx/server/query_and_chat/models.py /app/onyx/server/query_and_chat/models.py
COPY backend/onyx/server/query_and_chat/causl/ /app/onyx/server/query_and_chat/causl/
COPY backend/onyx/tools/tool_constructor.py /app/onyx/tools/tool_constructor.py
COPY backend/onyx/tools/tool_implementations/mcp/mcp_tool.py /app/onyx/tools/tool_implementations/mcp/mcp_tool.py
# Preserve the already deployed interview preparation alongside workspace isolation.
COPY backend/onyx/server/query_and_chat/burn2/__init__.py /app/onyx/server/query_and_chat/burn2/__init__.py
COPY backend/onyx/server/query_and_chat/burn2/api.py /app/onyx/server/query_and_chat/burn2/api.py
COPY backend/onyx/server/query_and_chat/burn2/profile.py /app/onyx/server/query_and_chat/burn2/profile.py
COPY backend/onyx/server/query_and_chat/burn2/research.py /app/onyx/server/query_and_chat/burn2/research.py
COPY backend/onyx/server/query_and_chat/burn2/requested_tool.py /app/onyx/server/query_and_chat/burn2/requested_tool.py

RUN python -m compileall -q /app/onyx/auth /app/onyx/chat /app/onyx/db /app/onyx/server/query_and_chat /app/onyx/tools
RUN python -c "from onyx.server.query_and_chat.burn2 import EXECUTIVE_INTERVIEW_PERSONA_NAMES; assert len(EXECUTIVE_INTERVIEW_PERSONA_NAMES) == 3"
