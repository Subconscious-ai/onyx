[Unit]
Description=Isolated rootless Docker for Burn Python execution
After=network-online.target
Wants=network-online.target

[Service]
User=burn-executor
Group=burn-executor
Environment=HOME=/var/lib/burn-executor
Environment=XDG_RUNTIME_DIR=/run/burn-executor
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RuntimeDirectory=burn-executor
RuntimeDirectoryMode=0700
ExecStart=/usr/local/lib/burn/dockerd-rootless.sh --host=unix:///run/burn-executor/docker.sock --data-root=/var/lib/burn-executor/docker
Restart=always
RestartSec=5
Delegate=yes
TasksMax=2048
MemoryMax=3G
CPUQuota=200%
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
