# Extend the verified executive runtime, preserving native dependencies.
ARG BURN_BASE_IMAGE
FROM ${BURN_BASE_IMAGE}
COPY backend/onyx/server/query_and_chat/burn2/ /app/onyx/server/query_and_chat/burn2/
COPY backend/onyx/db/burn2_research.py /app/onyx/db/burn2_research.py
COPY backend/onyx/background/celery/tasks/burn2/ /app/onyx/background/celery/tasks/burn2/
COPY backend/onyx/chat/process_message.py /app/onyx/chat/process_message.py
# Runtime primary.py predates two unrelated upstream tasks. Register only Burn.
RUN python - <<'PY'
from pathlib import Path
path = Path('/app/onyx/background/celery/apps/primary.py')
source = path.read_text()
anchor = '"onyx.background.celery.tasks.connector_deletion",'
assert source.count(anchor) == 1, 'Native task registration changed'
addition = '"onyx.background.celery.tasks.burn2",'
assert source.count(addition) <= 1, 'Duplicate Burn task registration'
if addition not in source:
    path.write_text(source.replace(anchor, anchor + '\n            ' + addition))
PY
COPY scripts/subconscious/test_research_startup.py /tmp/test_research_startup.py
COPY scripts/subconscious/test_background_preparation.py /tmp/test_background_preparation.py
