FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY scripts/subconscious/research-requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN git init upstream && cd upstream && git remote add origin https://github.com/assafelovic/gptr-mcp.git && git fetch --depth 1 origin 63884773685b1f12c7f0d9e283b3d71a5b9b5fda && git checkout FETCH_HEAD
COPY scripts/subconscious/serve_research.py /app/serve_research.py
RUN useradd --create-home --uid 10001 research && chown -R research:research /app
USER research
EXPOSE 3193
CMD ["python", "/app/serve_research.py", "--upstream", "/app/upstream", "--host", "0.0.0.0", "--port", "3193"]
