# Preparation-module overlay over a verified, fully configured native image.
ARG BURN_BASE_IMAGE
FROM ${BURN_BASE_IMAGE}
COPY --link backend/onyx/server/query_and_chat/burn2/api.py /app/onyx/server/query_and_chat/burn2/api.py
COPY --link backend/onyx/server/query_and_chat/burn2/profile.py /app/onyx/server/query_and_chat/burn2/profile.py
COPY --link backend/onyx/server/query_and_chat/burn2/research.py /app/onyx/server/query_and_chat/burn2/research.py
