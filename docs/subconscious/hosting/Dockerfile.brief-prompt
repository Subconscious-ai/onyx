# For the brief API and its shared persona gate over a verified native image.
ARG BURN_BASE_IMAGE
FROM ${BURN_BASE_IMAGE}
COPY --link backend/onyx/server/query_and_chat/burn2/api.py /app/onyx/server/query_and_chat/burn2/api.py
COPY --link backend/onyx/server/query_and_chat/burn2/__init__.py /app/onyx/server/query_and_chat/burn2/__init__.py
RUN python -c "from onyx.server.query_and_chat.burn2 import EXECUTIVE_INTERVIEW_PERSONA_NAMES; assert len(EXECUTIVE_INTERVIEW_PERSONA_NAMES) == 3"
