      "readOnly": false
    },
    "apply_model_source": {
      "action": "apply-source",
      "description": "Create or restructure a complete financial model using restricted grid-compatible Squiggle source. Read source first. Requires explicit Apply.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 100000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "source",
          "rationale"
        ],
        "additionalProperties": false
      },
      "readOnly": false
    },
    "set_active_scenario": {
      "action": "set-scenario",
      "description": "Propose one active intervention from the original baseline. Requires explicit Apply.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "distribution": {
            "type": "string",
            "enum": [
              "POINT",
              "NORMAL",
              "LOGNORMAL",
              "BETA",
              "PERT",
              "GAMMA",
              "EXPONENTIAL",
              "BERNOULLI",
              "POISSON",
              "BINOMIAL",
              "UNIFORM",
              "TRIANGULAR",
              "LOGISTIC",
              "CAUCHY"
            ]
          },
          "expression": {
            "type": "string",
            "maxLength": 20000
          },
          "metricId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "primaryOutcomeMetricId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "distribution",
          "expression",
          "metricId",
          "name",
          "rationale"
        ],
        "additionalProperties": false
      },
      "readOnly": false
    },
    "create_scenarios": {
      "action": "create-scenarios",
      "description": "Create and save up to three independent named one-cell alternatives from the same baseline. Requires explicit Apply.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "scenarios": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "distribution": {
                  "type": "string",
                  "enum": [
                    "POINT",
                    "NORMAL",
                    "LOGNORMAL",
                    "BETA",
                    "PERT",
                    "GAMMA",
                    "EXPONENTIAL",
                    "BERNOULLI",
                    "POISSON",
                    "BINOMIAL",
                    "UNIFORM",
                    "TRIANGULAR",
                    "LOGISTIC",
                    "CAUCHY"
                  ]
                },
                "expression": {
                  "type": "string",
                  "maxLength": 20000
                },
                "metricId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "primaryOutcomeMetricId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "required": [
                "distribution",
                "expression",
                "metricId",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "scenarios",
          "rationale"
        ],
        "additionalProperties": false
      },
      "readOnly": false
    },
    "clear_scenario": {
      "action": "clear-scenario",
      "description": "Restore the original baseline while retaining saved alternatives. Requires explicit Apply.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "additionalProperties": false,
        "required": [
          "rationale"
        ]
      },
      "readOnly": false
    },
    "delete_scenario": {
      "action": "delete-scenario",
      "description": "Remove a saved scenario by scenarioId. Preserve the current grid and active intervention. Requires explicit Apply.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "scenarioId",
          "rationale"
        ],
        "additionalProperties": false
      },
      "readOnly": false
    },
    "activate_scenario": {
      "action": "activate-scenario",
      "description": "Activate a saved scenario by scenarioId. Reject stale baselines. Requires explicit Apply.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "scenarioId",
          "rationale"
        ],
        "additionalProperties": false
      },
      "readOnly": false
    },
    "set_sensitivity": {
      "action": "sensitivity",
      "description": "Open or close the existing sensitivity analysis for metricId. Does not edit financial assumptions.",
      "readOnly": true,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metricId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "metricId",
          "enabled"
        ]
      }
    },
    "build_model_chart": {
      "action": "chart",
      "description": "Build a distribution histogram for a grid metricId using current Squiggle simulation draws. Does not change the financial model.",
      "readOnly": true,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metricId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "metricId"
        ]
      }
    }
  }
}
