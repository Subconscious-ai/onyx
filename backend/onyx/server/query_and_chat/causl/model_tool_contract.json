{
  "version": 2,
  "source": "guesstimate-v3 src/lib/model-page/nativeTools.ts and model-agent/contracts.ts",
  "tools": {
    "inspect_model": {
      "action": "inspect-model",
      "description": "Inspect the current financial model, outputs and scenarios.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500
          }
        },
        "additionalProperties": false
      },
      "readOnly": true
    },
    "inspect_metric": {
      "action": "inspect-metric",
      "description": "Calculate a cell, its lineage and sensitivity. Use metricId from inspect_model.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "metricId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "metricId"
        ],
        "additionalProperties": false
      },
      "readOnly": true
    },
    "inspect_scenario": {
      "action": "inspect-scenario",
      "description": "Inspect the active and saved scenarios and calculated comparisons.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "readOnly": true
    },
    "read_model_source": {
      "action": "inspect-source",
      "description": "Read the current complete grid-compatible Squiggle source before whole-model editing.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "readOnly": true
    },
    "run_model_scratchpad": {
      "action": "run-scratchpad",
      "description": "Run bounded read-only Squiggle checks against current model variables. No model changes.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      },
      "readOnly": true
    },
    "prepare_model_change": {
      "action": "apply-edits",
      "description": "Propose typed cell additions, deletions, moves, assumptions, formulas, notes or units. Calculate and require explicit Apply in Models.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "edits": {
            "minItems": 1,
            "maxItems": 24,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "distribution": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "POINT",
                            "NORMAL",
                            "LOGNORMAL",
                            "BETA",
                            "PERT",
                            "GAMMA",
                            "EXPONENTIAL",
                            "BERNOULLI",
                            "POISSON",
                            "BINOMIAL",
                            "UNIFORM",
                            "TRIANGULAR",
                            "LOGISTIC",
                            "CAUCHY"
                          ]
                        },
                        {
                          "type": "string",
                          "const": "FUNCTION"
                        }
                      ]
                    },
                    "expression": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "kind": {
                      "type": "string",
                      "const": "create-metric"
                    },
                    "location": {
                      "type": "object",
                      "properties": {
                        "column": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "row": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        }
                      },
                      "required": [
                        "column",
                        "row"
                      ],
                      "additionalProperties": false
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180
                    },
                    "notes": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "readableId": {
                      "type": "string",
                      "maxLength": 120,
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                    },
                    "unit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "AUTO",
                            "NUMBER",
                            "PERCENT",
                            "USD",
                            "COUNT",
                            "USD_PER_COUNT"
                          ]
                        },
                        {
                          "type": "string",
                          "pattern": "^CUSTOM:[A-Za-z][A-Za-z0-9 _-]{0,31}$"
                        }
                      ]
                    }
                  },
                  "required": [
                    "distribution",
                    "expression",
                    "kind",
                    "location",
                    "name",
                    "notes",
                    "readableId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "delete-metric"
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "required": [
                    "kind",
                    "metricId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "move-metric"
                    },
                    "location": {
                      "type": "object",
                      "properties": {
                        "column": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "row": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        }
                      },
                      "required": [
                        "column",
                        "row"
                      ],
                      "additionalProperties": false
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "required": [
                    "kind",
                    "location",
                    "metricId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "distribution": {
                      "type": "string",
                      "enum": [
                        "POINT",
                        "NORMAL",
                        "LOGNORMAL",
                        "BETA",
                        "PERT",
                        "GAMMA",
                        "EXPONENTIAL",
                        "BERNOULLI",
                        "POISSON",
                        "BINOMIAL",
                        "UNIFORM",
                        "TRIANGULAR",
                        "LOGISTIC",
                        "CAUCHY"
                      ]
                    },
                    "expression": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "kind": {
                      "type": "string",
                      "const": "set-assumption"
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "required": [
                    "distribution",
                    "expression",
                    "kind",
                    "metricId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "expression": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "kind": {
                      "type": "string",
                      "const": "set-formula"
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "required": [
                    "expression",
                    "kind",
                    "metricId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "set-notes"
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "notes": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "kind",
                    "metricId",
                    "notes"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "set-unit"
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "unit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "AUTO",
                            "NUMBER",
                            "PERCENT",
                            "USD",
                            "COUNT",
                            "USD_PER_COUNT"
                          ]
                        },
                        {
                          "type": "string",
                          "pattern": "^CUSTOM:[A-Za-z][A-Za-z0-9 _-]{0,31}$"
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "metricId",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "edits",
          "rationale"
        ],
        "additionalProperties": false
      },
      "readOnly": false
    },
    "apply_model_edits": {
      "action": "apply-edits",
      "description": "Propose typed cell edits. Formula expressions use stable references, e.g. =${metric:revenue}-${metric:cost}. Use set-assumption for fixed values or distributions. Changing distribution changes a cell type; set-formula creates a formula cell. Requires explicit Apply.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "edits": {
            "minItems": 1,
            "maxItems": 24,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "distribution": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "POINT",
                            "NORMAL",
                            "LOGNORMAL",
                            "BETA",
                            "PERT",
                            "GAMMA",
                            "EXPONENTIAL",
                            "BERNOULLI",
                            "POISSON",
                            "BINOMIAL",
                            "UNIFORM",
                            "TRIANGULAR",
                            "LOGISTIC",
                            "CAUCHY"
                          ]
                        },
                        {
                          "type": "string",
                          "const": "FUNCTION"
                        }
                      ]
                    },
                    "expression": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "kind": {
                      "type": "string",
                      "const": "create-metric"
                    },
                    "location": {
                      "type": "object",
                      "properties": {
                        "column": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "row": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        }
                      },
                      "required": [
                        "column",
                        "row"
                      ],
                      "additionalProperties": false
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180
                    },
                    "notes": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "readableId": {
                      "type": "string",
                      "maxLength": 120,
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                    },
                    "unit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "AUTO",
                            "NUMBER",
                            "PERCENT",
                            "USD",
                            "COUNT",
                            "USD_PER_COUNT"
                          ]
                        },
                        {
                          "type": "string",
                          "pattern": "^CUSTOM:[A-Za-z][A-Za-z0-9 _-]{0,31}$"
                        }
                      ]
                    }
                  },
                  "required": [
                    "distribution",
                    "expression",
                    "kind",
                    "location",
                    "name",
                    "notes",
                    "readableId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "delete-metric"
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "required": [
                    "kind",
                    "metricId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "move-metric"
                    },
                    "location": {
                      "type": "object",
                      "properties": {
                        "column": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "row": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        }
                      },
                      "required": [
                        "column",
                        "row"
                      ],
                      "additionalProperties": false
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "required": [
                    "kind",
                    "location",
                    "metricId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "distribution": {
                      "type": "string",
                      "enum": [
                        "POINT",
                        "NORMAL",
                        "LOGNORMAL",
                        "BETA",
                        "PERT",
                        "GAMMA",
                        "EXPONENTIAL",
                        "BERNOULLI",
                        "POISSON",
                        "BINOMIAL",
                        "UNIFORM",
                        "TRIANGULAR",
                        "LOGISTIC",
                        "CAUCHY"
                      ]
                    },
                    "expression": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "kind": {
                      "type": "string",
                      "const": "set-assumption"
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "required": [
                    "distribution",
                    "expression",
                    "kind",
                    "metricId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "expression": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "kind": {
                      "type": "string",
                      "const": "set-formula"
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "required": [
                    "expression",
                    "kind",
                    "metricId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "set-notes"
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "notes": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "kind",
                    "metricId",
                    "notes"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "set-unit"
                    },
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "unit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "AUTO",
                            "NUMBER",
                            "PERCENT",
                            "USD",
                            "COUNT",
                            "USD_PER_COUNT"
                          ]
                        },
                        {
                          "type": "string",
                          "pattern": "^CUSTOM:[A-Za-z][A-Za-z0-9 _-]{0,31}$"
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "metricId",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
